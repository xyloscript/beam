-- === AUTO FARM CANDY (Salpak) ===
local isFarming = false
local farmingConnection = nil
local farmSpeed = 50

local function getNearestCoin()
    local mapObj = nil
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:GetAttribute("MapID") and obj:FindFirstChild("CoinContainer") then
            mapObj = obj
            break
        end
    end
    if not mapObj then return nil end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local closest, dist = nil, math.huge
    for _, coin in ipairs(mapObj.CoinContainer:GetChildren()) do
        local v = coin:FindFirstChild("CoinVisual")
        if v and not v:GetAttribute("Collected") then
            local d = (hrp.Position - coin.Position).Magnitude
            if d < dist then
                closest = coin
                dist = d
            end
        end
    end
    return closest
end

local function tpToCoin(coin)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    
    hum:ChangeState(11)
    local d = (hrp.Position - coin.Position).Magnitude
    local t = TweenService:Create(hrp, TweenInfo.new(d / farmSpeed, Enum.EasingStyle.Linear), {CFrame = coin.CFrame})
    t:Play()
    t.Completed:Wait()
end

local function startFarming()
    if farmingConnection then return end
    farmingConnection = task.spawn(function()
        while isFarming do
            local target = getNearestCoin()
            if target and LocalPlayer:GetAttribute("Alive") then
                tpToCoin(target)
                local v = target:FindFirstChild("CoinVisual")
                while v and not v:GetAttribute("Collected") and v.Parent and isFarming do
                    if not LocalPlayer:GetAttribute("Alive") then break end
                    local n = getNearestCoin()
                    if n and n ~= target then break end
                    task.wait()
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

local function stopFarming()
    isFarming = false
    farmingConnection = nil
end

makeSlider(MiscTab, tbl.misc, "Candy Farm Speed", 10, 150, 50, 1, function(v)
    farmSpeed = v
end)

makeToggle(MiscTab, tbl.misc, "Auto Farm Candy", false, function(state)
    isFarming = state
    if isFarming then
        startFarming()
        makeNotify("Farm Started", "Auto farming candies...", 3, tbl.misc)
    else
        stopFarming()
        makeNotify("Farm Stopped", "Auto farming stopped.", 3, tbl.misc)
    end
end)
