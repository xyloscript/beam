local function makeSlider(parent, image, text, minV, maxV, initV, step, cb)
    local row = makeRow(parent, 50)
    local ic = Instance.new("ImageLabel", row)
    ic.Image = image; ic.ImageColor3 = tbl5.accentDim; ic.BackgroundTransparency = 1
    ic.Size = UDim2.new(0,15,0,15); ic.Position = UDim2.new(0,12,0,10); ic.ZIndex = 8
    local lb = Instance.new("TextLabel", row)
    lb.Size = UDim2.new(1,-90,0,15); lb.Position = UDim2.new(0,36,0,6)
    lb.BackgroundTransparency = 1; lb.Text = text; lb.TextColor3 = tbl5.text; lb.TextSize = 12; lb.Font = Enum.Font.GothamMedium; lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 8
    local vl = Instance.new("TextLabel", row)
    vl.Size = UDim2.new(0,52,0,15); vl.Position = UDim2.new(1,-60,0,6); vl.BackgroundTransparency = 1
    vl.Text = string.format(step<1 and "%.2f" or "%d", initV); vl.TextColor3 = tbl5.accentHi; vl.TextSize = 12; vl.Font = Enum.Font.GothamBold; vl.TextXAlignment = Enum.TextXAlignment.Right; vl.ZIndex = 8
    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1,-24,0,4); track.Position = UDim2.new(0,12,0,34); track.BackgroundColor3 = tbl5.bgHi; track.BorderSizePixel = 0; track.ZIndex = 8
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((initV-minV)/(maxV-minV),0,1,0); fill.BackgroundColor3 = tbl5.accent; fill.BorderSizePixel = 0; fill.ZIndex = 9
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    local thumb = Instance.new("Frame", track)
    thumb.Size = UDim2.new(0,12,0,12); thumb.Position = UDim2.new((initV-minV)/(maxV-minV),-6,0.5,-6); thumb.BackgroundColor3 = tbl5.white; thumb.BorderSizePixel = 0; thumb.ZIndex = 10
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1,0)
    local dragging = false
    local function upd(x)
        local px = track.AbsolutePosition.X; local sx = track.AbsoluteSize.X; if sx <= 0 then return end
        local t = math.clamp((x - px) / sx, 0, 1)
        local raw = minV + t * (maxV - minV)
        local sn = math.clamp(math.floor(raw/step+0.5)*step, minV, maxV)
        local finalT = (sn-minV)/(maxV-minV)
        fill.Size = UDim2.new(finalT,0,1,0); thumb.Position = UDim2.new(finalT,-6,0.5,-6)
        vl.Text = string.format(step<1 and "%.2f" or "%d", sn)
        cb(sn)
    end
    thumb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then dragging = false; fn() end
        end
    end)
    return row
end

